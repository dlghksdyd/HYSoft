<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <RootNamespace>HYSoft.Communication.Tests</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 시험 어셈블리는 NuGet 번들(Staging)에 들어가면 안 된다. 전역 xmlns 생성도 필요 없다 -->
    <HysoftBundleStagingEnabled>false</HysoftBundleStagingEnabled>
    <HysoftXmlnsEnabled>false</HysoftXmlnsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Communication\Communication.csproj" />
    <ProjectReference Include="..\..\src\Communication.FileTransfer\Communication.FileTransfer.csproj" />
  </ItemGroup>

</Project>
