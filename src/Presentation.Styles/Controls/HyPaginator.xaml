<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:HYSoft.Presentation.Styles.ColorTokens"
    xmlns:local="clr-namespace:HYSoft.Presentation.Styles.Controls">

    <Style TargetType="{x:Type local:HyPaginator}">
        <Setter Property="Foreground" Value="{c:Color TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HyPaginator}">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- First Page -->
                            <!-- 🔴 [work-4002] 크기·글자 크기·여백은 리터럴이 아니라 HyPaginator 의 DP 다.
                                 기본값은 종전 리터럴과 동일(24 / 4 / 4,0,0,0 / 10 / 8 / 8,0,8,0)이므로
                                 값을 주지 않는 화면의 렌더는 바뀌지 않는다. 소비처가 크게 쓰고 싶으면
                                 ScaleTransform 이 아니라 이 속성들을 준다(23-uiux-design §5). -->
                            <Button
                                x:Name="PART_FirstButton"
                                Width="{TemplateBinding ButtonSize}" Height="{TemplateBinding ButtonSize}"
                                Padding="{TemplateBinding ButtonPadding}"
                                Cursor="Hand"
                                Focusable="False"
                                Content="&#x23EE;"
                                FontSize="{TemplateBinding FirstLastGlyphFontSize}"
                                Foreground="{TemplateBinding Foreground}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="BtnBorder"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="0"
                                            Padding="{TemplateBinding Padding}">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#10000000" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#20000000" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Previous Page -->
                            <Button
                                x:Name="PART_PreviousButton"
                                Width="{TemplateBinding ButtonSize}" Height="{TemplateBinding ButtonSize}"
                                Margin="{TemplateBinding ButtonSpacing}"
                                Padding="{TemplateBinding ButtonPadding}"
                                Cursor="Hand"
                                Focusable="False"
                                Content="&#x25C0;"
                                FontSize="{TemplateBinding PrevNextGlyphFontSize}"
                                Foreground="{TemplateBinding Foreground}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="BtnBorder"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="0"
                                            Padding="{TemplateBinding Padding}">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#10000000" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#20000000" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Page Info -->
                            <TextBlock
                                Margin="{TemplateBinding PageInfoMargin}"
                                VerticalAlignment="Center"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Page {0} of {1}">
                                        <Binding Path="CurrentPage" RelativeSource="{RelativeSource TemplatedParent}" />
                                        <Binding Path="TotalPages" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <!-- Next Page -->
                            <Button
                                x:Name="PART_NextButton"
                                Width="{TemplateBinding ButtonSize}" Height="{TemplateBinding ButtonSize}"
                                Padding="{TemplateBinding ButtonPadding}"
                                Cursor="Hand"
                                Focusable="False"
                                Content="&#x25B6;"
                                FontSize="{TemplateBinding PrevNextGlyphFontSize}"
                                Foreground="{TemplateBinding Foreground}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="BtnBorder"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="0"
                                            Padding="{TemplateBinding Padding}">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#10000000" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#20000000" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Last Page -->
                            <Button
                                x:Name="PART_LastButton"
                                Width="{TemplateBinding ButtonSize}" Height="{TemplateBinding ButtonSize}"
                                Margin="{TemplateBinding ButtonSpacing}"
                                Padding="{TemplateBinding ButtonPadding}"
                                Cursor="Hand"
                                Focusable="False"
                                Content="&#x23ED;"
                                FontSize="{TemplateBinding FirstLastGlyphFontSize}"
                                Foreground="{TemplateBinding Foreground}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="BtnBorder"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="0"
                                            Padding="{TemplateBinding Padding}">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#10000000" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#20000000" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.4" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
