<UserControl
    x:Class="Docs.Mvvm.Communication.FileTransferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hy="http://schemas.hysoft.com/wpf/2025/xaml"
    xmlns:local="clr-namespace:Docs.Mvvm.Communication"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="{hy:Color SurfaceBase}"
    d:DesignHeight="1600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Border Margin="20">
        <hy:HyScrollViewer>
            <StackPanel Margin="0,0,10,0" Orientation="Vertical">
                <TextBlock Style="{StaticResource DocsPageTitle}" Text="File Transfer (FT10)" />
                <TextBlock Style="{StaticResource DocsLead}" Text="HYSoft.Communication.FileTransfer sends one file per call over TcpClient / TcpServer, verifies it with CRC-32 and reports progress. The receiving side writes files into a single storage folder." />

                <TextBlock Style="{StaticResource DocsSection}" Text="1. Protocol" />
                <TextBox Style="{StaticResource DocsCode}" Text="{x:Static local:CommunicationContent.FileTransferProtocol}" />

                <TextBlock Style="{StaticResource DocsSection}" Text="2. API" />
                <ItemsControl ItemsSource="{x:Static local:CommunicationContent.FileTransferMembers}" Style="{StaticResource DocsTable}" />

                <TextBlock Style="{StaticResource DocsSection}" Text="3. Usage" />
                <TextBox Style="{StaticResource DocsCode}" Text="{x:Static local:CommunicationContent.FileTransferUsage}" />

                <TextBlock Style="{StaticResource DocsSection}" Text="4. Client errors" />
                <TextBlock Style="{StaticResource DocsBody}" Text="ArgumentException (empty path), FileNotFoundException, InvalidOperationException (a transfer is already running on this instance, or the file name exceeds 65535 UTF-8 bytes), IOException (server rejected the header or reported a CRC / protocol error), OperationCanceledException (token cancelled between chunks), TimeoutException / SocketException (no answer within ReceiveTimeout, or the connection broke)." />
                <TextBlock Style="{StaticResource DocsBody}" Text="After any failure the client drops its connection; the next SendFileAsync reconnects and, if the server kept the partial file, resumes from it." />

                <TextBlock Style="{StaticResource DocsSection}" Text="5. Server behaviour" />
                <TextBlock Style="{StaticResource DocsBody}" Text="- The received name is sanitized ('..', '/', '\' and invalid characters become '_') and the file must land directly in storageRoot, otherwise the header is rejected." />
                <TextBlock Style="{StaticResource DocsBody}" Text="- Data is written to '&lt;name&gt;.ftpart'. Only when the whole-file CRC matches is it renamed to '&lt;name&gt;', replacing an existing file. Until then an existing file of that name is untouched." />
                <TextBlock Style="{StaticResource DocsBody}" Text="- Resume: if '&lt;name&gt;.ftpart' exists and is not longer than the new file, the server answers RESUME with its length and the client sends only the rest. The final CRC still covers the whole file." />
                <TextBlock Style="{StaticResource DocsBody}" Text="- CRC mismatch or a damaged tail: the server answers 0xFF and deletes the partial file, so the next attempt starts from zero. A dropped connection keeps the partial file for resume." />
                <TextBlock Style="{StaticResource DocsBody}" Text="- Chunks of one connection are processed in arrival order; the next read waits until the previous chunk is on disk, so a slow disk slows the sender instead of buffering in memory." />
                <TextBlock Style="{StaticResource DocsBody}" Text="- Dispose closes the listener and all connections. A disposed server cannot be started again." />

                <Border Margin="0,8,0,16" Style="{StaticResource DocsNote}">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Style="{StaticResource DocsNoteText}" Text="Resume trusts the file name" />
                        <TextBlock Style="{StaticResource DocsNoteText}" Text="The header carries no file identity, so a partial file with the same name is assumed to be the start of the same file. If it is not, the final CRC fails, the partial is deleted and the retry sends the whole file - one wasted attempt, never a corrupt result." />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource DocsBody}" Text="A runnable client/server pair is included in TestApp (Samples/FileTransfer)." />
            </StackPanel>
        </hy:HyScrollViewer>
    </Border>
</UserControl>
