<UserControl
    x:Class="Docs.Mvvm.Communication.TcpEchoDemoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hy="http://schemas.hysoft.com/wpf/2025/xaml"
    xmlns:local="clr-namespace:Docs.Mvvm.Communication"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Background="{hy:Color SurfaceBase}"
    d:DataContext="{d:DesignInstance local:TcpEchoDemoViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="800"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Border Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource DocsPageTitle}" Text="Live Echo Demo" />
            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,16"
                Style="{StaticResource DocsLead}"
                Text="Runs a real TcpServer and TcpClient inside this app on 127.0.0.1 only. The server echoes every read back with ReplyAsync; the client sends your message and reads exactly the same number of bytes. Leaving this page stops both." />

            <!--  1. 서버  -->
            <StackPanel
                Grid.Row="2"
                Margin="0,0,0,12"
                Orientation="Horizontal">
                <TextBlock
                    Width="70"
                    VerticalAlignment="Center"
                    FontSize="{hy:FontSize Md}"
                    Foreground="{hy:Color TextPrimary}"
                    Text="Server" />
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="{hy:FontSize Sm}"
                    Foreground="{hy:Color TextSecondary}"
                    Text="127.0.0.1 :" />
                <hy:HyTextBox
                    Width="90"
                    Height="32"
                    Margin="0,0,12,0"
                    BorderBrush="{hy:Color BorderDefault}"
                    BorderThickness="1"
                    IsEnabled="{Binding CanEditPort}"
                    IsOnlyNumber="True"
                    MaxLength="5"
                    Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                    Watermark="Port"
                    WatermarkForeground="{hy:Color TextWatermark}" />
                <hy:HyButton
                    Margin="0,0,8,0"
                    Padding="16,6"
                    Command="{Binding StartServerCommand}"
                    Content="Start" />
                <hy:HyButton
                    Padding="16,6"
                    Command="{Binding StopServerCommand}"
                    Content="Stop" />
            </StackPanel>

            <!--  2. 클라이언트  -->
            <StackPanel
                Grid.Row="3"
                Margin="0,0,0,12"
                Orientation="Horizontal">
                <TextBlock
                    Width="70"
                    VerticalAlignment="Center"
                    FontSize="{hy:FontSize Md}"
                    Foreground="{hy:Color TextPrimary}"
                    Text="Client" />
                <hy:HyButton
                    Margin="0,0,8,0"
                    Padding="16,6"
                    Command="{Binding ConnectCommand}"
                    Content="Connect" />
                <hy:HyButton
                    Margin="0,0,16,0"
                    Padding="16,6"
                    Command="{Binding DisconnectCommand}"
                    Content="Disconnect" />
                <hy:HyTextBox
                    Width="320"
                    Height="32"
                    Margin="0,0,8,0"
                    BorderBrush="{hy:Color BorderDefault}"
                    BorderThickness="1"
                    MaxLength="1024"
                    Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                    Watermark="Message to send"
                    WatermarkForeground="{hy:Color TextWatermark}" />
                <hy:HyButton
                    Padding="16,6"
                    Command="{Binding SendCommand}"
                    Content="Send" />
            </StackPanel>

            <!--  3. 상태  -->
            <Grid Grid.Row="4" Margin="0,0,0,8">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{hy:FontSize Sm}"
                    Foreground="{hy:Color TextSecondary}"
                    Text="{Binding StatusText}" />
                <hy:HyButton
                    Padding="12,4"
                    HorizontalAlignment="Right"
                    Command="{Binding ClearLogCommand}"
                    Content="Clear log" />
            </Grid>

            <!--  4. 로그  -->
            <Border
                Grid.Row="5"
                MinHeight="200"
                Background="{hy:Color SurfaceSubtle}"
                BorderBrush="{hy:Color BorderDefault}"
                BorderThickness="1">
                <hy:HyScrollViewer x:Name="LogScrollViewer" Padding="12,8">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,1"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="{hy:FontSize Sm}"
                                    Foreground="{hy:Color TextPrimary}"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </hy:HyScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
