<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hy="http://schemas.hysoft.com/wpf/2025/xaml"
    xmlns:shared="clr-namespace:Docs.Mvvm.Shared">

    <!--  문서 페이지 공용 스타일 — DB Support · Communication 페이지가 쓴다  -->

    <Style x:Key="DocsPageTitle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="FontSize" Value="{hy:FontSize _2Xl}" />
        <Setter Property="Foreground" Value="{hy:Color TextPrimary}" />
    </Style>

    <Style x:Key="DocsLead" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="FontSize" Value="{hy:FontSize Md}" />
        <Setter Property="Foreground" Value="{hy:Color TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DocsSection" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,12" />
        <Setter Property="FontSize" Value="{hy:FontSize Xl}" />
        <Setter Property="Foreground" Value="{hy:Color TextPrimary}" />
    </Style>

    <Style x:Key="DocsBody" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="FontSize" Value="{hy:FontSize Sm}" />
        <Setter Property="Foreground" Value="{hy:Color TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  코드 블록 — 읽기 전용 TextBox 라서 선택·복사가 된다  -->
    <Style x:Key="DocsCode" TargetType="TextBox">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="{hy:FontSize Sm}" />
        <Setter Property="Foreground" Value="{hy:Color TextPrimary}" />
        <Setter Property="Background" Value="{hy:Color SurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{hy:Color BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!--  주의 상자 — 현재 구현의 제약을 알린다  -->
    <Style x:Key="DocsNote" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{hy:Color SurfaceSubtle}" />
        <Setter Property="BorderBrush" Value="{hy:Color BorderWarning}" />
        <Setter Property="BorderThickness" Value="4,0,0,0" />
    </Style>

    <Style x:Key="DocsNoteText" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="{hy:FontSize Sm}" />
        <Setter Property="Foreground" Value="{hy:Color TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  표 — 첫 행이 머리글(IsHeader)이다. 열 너비는 SharedSizeGroup 으로 맞춘다  -->
    <Style x:Key="DocsTable" TargetType="ItemsControl">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="BorderBrush" Value="{hy:Color BorderDefault}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>

    <Style x:Key="DocsCell" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,6" />
        <Setter Property="FontSize" Value="{hy:FontSize Sm}" />
        <Setter Property="Foreground" Value="{hy:Color TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DocsCodeCell" BasedOn="{StaticResource DocsCell}" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter Property="FontFamily" Value="Pretendard" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DocsRowBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{hy:Color BorderDefault}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter Property="Background" Value="{hy:Color SurfaceSubtle}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate DataType="{x:Type shared:OptionRow}">
        <Border Style="{StaticResource DocsRowBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OptName" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OptType" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="OptDefault" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource DocsCodeCell}" Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Style="{StaticResource DocsCodeCell}" Text="{Binding Type}" />
                <TextBlock Grid.Column="2" Style="{StaticResource DocsCodeCell}" Text="{Binding Default}" />
                <TextBlock Grid.Column="3" Style="{StaticResource DocsCell}" Text="{Binding Description}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!--  멤버 표 — 시그니처가 길어 열을 나누면 설명이 밀려난다. 시그니처 아래에 설명을 둔다  -->
    <DataTemplate DataType="{x:Type shared:MemberRow}">
        <Border Style="{StaticResource DocsRowBorder}">
            <StackPanel Margin="0,4">
                <TextBlock
                    Margin="10,4,10,2"
                    FontWeight="SemiBold"
                    Style="{StaticResource DocsCodeCell}"
                    Text="{Binding Signature}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="10,0,10,4"
                    Foreground="{hy:Color TextSecondary}"
                    Style="{StaticResource DocsCell}"
                    Text="{Binding Description}" />
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
