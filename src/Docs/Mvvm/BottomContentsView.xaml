<UserControl
    x:Class="Docs.Mvvm.BottomContentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hy="http://schemas.hysoft.com/wpf/2025/xaml"
    xmlns:leftMenu="clr-namespace:Docs.Mvvm.LeftMenu"
    xmlns:local="clr-namespace:Docs.Mvvm"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance local:BottomContentsViewModel,
                                     IsDesignTimeCreatable=True}"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type leftMenu:LeftMenuViewModel}">
            <leftMenu:LeftMenuView DataContext="{Binding}" />
        </DataTemplate>

        <!--  상단 메뉴 — 선택되지 않은 영역은 흐리게, 선택된 영역은 밑줄로 표시  -->
        <Style x:Key="TopNavItem" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Padding="40,0"
            Background="{hy:Color NavigationMenuBarBg}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,60,0"
                    Cursor="Hand"
                    FontSize="{hy:FontSize lg}"
                    FontWeight="Bold"
                    Foreground="{hy:Color NavigationMenuBarFg}"
                    Text="UI Support">
                    <hy:EventToCommand.Binding>
                        <hy:Event
                            Command="{Binding SharedContext.UpdateLeftMenuItemCommand}"
                            CommandParameter="{x:Static leftMenu:ELeftMenuType.UiSupport}"
                            RoutedEvent="{x:Static TextBlock.MouseLeftButtonUpEvent}" />
                    </hy:EventToCommand.Binding>
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource TopNavItem}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SharedContext.CurrentMenuType}" Value="{x:Static leftMenu:ELeftMenuType.UiSupport}">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="TextDecorations" Value="Underline" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    Margin="0,0,60,0"
                    Cursor="Hand"
                    FontSize="{hy:FontSize lg}"
                    FontWeight="Bold"
                    Foreground="{hy:Color NavigationMenuBarFg}"
                    Text="DB Support">
                    <hy:EventToCommand.Binding>
                        <hy:Event
                            Command="{Binding SharedContext.UpdateLeftMenuItemCommand}"
                            CommandParameter="{x:Static leftMenu:ELeftMenuType.DbSupport}"
                            RoutedEvent="{x:Static TextBlock.MouseLeftButtonUpEvent}" />
                    </hy:EventToCommand.Binding>
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource TopNavItem}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SharedContext.CurrentMenuType}" Value="{x:Static leftMenu:ELeftMenuType.DbSupport}">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="TextDecorations" Value="Underline" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    Margin="0,0,60,0"
                    Cursor="Hand"
                    FontSize="{hy:FontSize lg}"
                    FontWeight="Bold"
                    Foreground="{hy:Color NavigationMenuBarFg}"
                    Text="Communication">
                    <hy:EventToCommand.Binding>
                        <hy:Event
                            Command="{Binding SharedContext.UpdateLeftMenuItemCommand}"
                            CommandParameter="{x:Static leftMenu:ELeftMenuType.Communication}"
                            RoutedEvent="{x:Static TextBlock.MouseLeftButtonUpEvent}" />
                    </hy:EventToCommand.Binding>
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource TopNavItem}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SharedContext.CurrentMenuType}" Value="{x:Static leftMenu:ELeftMenuType.Communication}">
                                    <Setter Property="Opacity" Value="1" />
                                    <Setter Property="TextDecorations" Value="Underline" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" d:Background="{hy:Color SurfaceBase}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ContentPresenter Grid.Column="0" Content="{Binding Menu}" />
            <ContentPresenter Grid.Column="1" Content="{Binding SharedContext.Content}" />
        </Grid>
    </Grid>

</UserControl>
